# DeepSeek API 配置
# 使用方法：把本文件复制为 .env（同一目录下），填入你的真实 key。
# .env 已在 .gitignore 中忽略，不会被提交到 git，安全。

DEEPSEEK_API_KEY=sk-在这里填你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 图片识别使用支持 image_url 输入的 OpenAI 兼容视觉模型
VISION_API_KEY=在这里填视觉模型的key
VISION_BASE_URL=https://你的视觉服务地址/v1
VISION_MODEL=你的视觉模型名称
